{
  "name": "@yanuka/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/contract-tests.d.ts",
      "default": "./dist/contract-tests.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@yanuka/database": "workspace:*",
    "@yanuka/search": "workspace:*",
    "@yanuka/types": "workspace:*",
    "@yanuka/utils": "workspace:*",
    "@yanuka/validation": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@yanuka/config": "workspace:*",
    "eslint": "^9.39.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
