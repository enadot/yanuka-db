# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Rust / Tauri
target/
apps/desktop/src-tauri/target/
# Generated by the Tauri build; regenerated on every compile.
apps/desktop/src-tauri/gen/*
# ...except the Android project, which is generated once and then edited: the
# Hebrew launcher name, RTL support and the icons live in it. Re-running
# `tauri android init` on a fresh clone would silently discard all of it. Its
# own .gitignore files keep the build output out.
!apps/desktop/src-tauri/gen/android

# Local databases and backups — never commit real contact data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backups/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/src-tauri/icons/*
signing/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test output
coverage/
playwright-report/
test-results/

# Rust
Cargo.lock.orig
