{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "אוצר שלמה",
  "mainBinaryName": "OtzarShlomo",
  "version": "0.8.0",
  "identifier": "digital.baram.yanuka",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -w run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "אוצר שלמה",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/semantic/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "copyright": "",
    "shortDescription": "מאגר קשרים חכם",
    "longDescription": "מאגר אנשי קשר חכם שעובד במלואו גם ללא חיבור לאינטרנט",
    "windows": {
      "nsis": {
        "languages": ["Hebrew", "English"],
        "customLanguageFiles": {
          "Hebrew": "./windows/Hebrew.nsh"
        },
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "./icons/icon.ico",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "headerImage": "./windows/installer-header.bmp"
      }
    }
  }
}
